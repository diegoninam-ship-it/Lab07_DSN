# Variables de entorno de ejemplo. Copia este archivo a .env y completa los
# valores reales; .env nunca se versiona (ver .gitignore).

FLASK_APP=wsgi

# Obligatoria. Al menos 32 caracteres.
# Generar una nueva con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=genera-uno-con-python-secrets-token-urlsafe-50-caracteres-o-mas

# Obligatoria. Debe empezar con postgresql:// o postgresql+psycopg://
# (se normaliza siempre a postgresql+psycopg://).
#
# Desarrollo local (contenedor postgres:18-alpine, ver sección 9.1 de CONTEXT.md):
DATABASE_URL=postgresql://lab07:lab07@localhost:5433/lab07_dev
#
# Producción (Neon, solo la usa el usuario en la etapa 3 — nunca el agente):
# DATABASE_URL=postgresql://usuario:password@host-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Solo necesaria si USE_DIRECT_DB=1 (migraciones contra Neon sin el pooler).
# DATABASE_URL_DIRECT=postgresql://usuario:password@host.us-east-2.aws.neon.tech/neondb?sslmode=require

# 0 o 1. Por defecto 0. Con 1, la app usa DATABASE_URL_DIRECT en vez de DATABASE_URL.
USE_DIRECT_DB=0

# Opcional. Por defecto, el hostname de la máquina. Solo ASCII imprimible, 1-100 caracteres.
SERVER_ID=Local-dev

# web o api. Por defecto web.
APP_MODE=web

# 0 o 1. Por defecto 0. Habilita la ruta /carga.
LOAD_TEST=0

# Entero entre 1000 y 5000000. Por defecto 200000. Iteraciones de /carga.
CARGA_ITERACIONES=200000

# 0 o 1. Por defecto 0. Poner en 1 solo cuando la app se sirva sobre HTTPS.
SESSION_COOKIE_SECURE=0

# 0 o 1. Por defecto 0. Poner en 1 cuando la app esté detrás de Nginx o del ALB.
DETRAS_DE_PROXY=0

# Solo para pruebas (pytest). Nunca debe apuntar a Neon.
TEST_DATABASE_URL=postgresql://lab07:lab07@localhost:5433/lab07_test
